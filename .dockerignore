# ============================================
# Docker 构建忽略文件
# 排除不需要复制到镜像的文件
# ============================================

# Python虚拟环境
.venv/
venv/
env/
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# Node.js
frontend/node_modules/
frontend/.vite/
frontend/dist/

# IDE配置
.idea/
.vscode/
*.swp
*.swo
*~

# Git
.git/
.gitignore

# Docker相关
docker-compose*.yml
Dockerfile*
.docker/
.dockerignore

# 环境变量文件
.env
.env.*
!.env.example

# 日志文件
*.log
logs/

# 数据库文件
*.db
*.sqlite
*.sqlite3

# 上传文件（开发环境）
backend/uploads/*
!backend/uploads/.gitkeep

# 测试和覆盖率
.coverage
htmlcov/
.pytest_cache/
.tox/

# 临时文件
tmp/
temp/
*.tmp
*.temp

# 系统文件
.DS_Store
Thumbs.db

# 文档
docs/
*.md
!README.md
