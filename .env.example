# ============================================
# DS-System 环境变量配置示例
# 使用远程数据库版本
# ============================================

# ==================== 远程数据库配置 ====================
# MySQL用户名
DB_USER=root

# MySQL密码
DB_PASSWORD=123456

# MySQL主机地址（远程数据库IP或域名）
# 示例：192.168.1.100 或 mysql.example.com
DB_HOST=192.168.1.100

# MySQL端口
DB_PORT=3306

# 主数据库名称
DB_NAME=webtools

# 数据共享数据库名称
DATASHARE_DB_NAME=datashare

# ==================== 应用配置 ====================
# 应用服务端口
APP_PORT=5001

# Nginx服务端口（Web访问端口）
NGINX_PORT=80

# ==================== 安全配置（必须修改！）====================
# JWT密钥（使用命令生成：openssl rand -hex 32）
JWT_SECRET_KEY=your-jwt-secret-key-change-in-production-32chars

# JWT访问令牌过期时间（秒）
JWT_ACCESS_TOKEN_EXPIRES=3600

# Flask密钥（使用命令生成：openssl rand -hex 32）
SECRET_KEY=your-flask-secret-key-change-in-production-32chars

# ==================== 文件上传配置 ====================
# 最大文件上传大小（MB）
MAX_CONTENT_LENGTH=100

# ==================== 调试配置 ====================
# 调试模式（生产环境请设置为False）
DEBUG=False
