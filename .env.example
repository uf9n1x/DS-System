# ============================================
# DS-System 环境变量配置示例
# 复制此文件为 .env 并修改配置值
# ============================================

# ==================== 数据库配置 ====================
# MySQL root用户密码（重要：生产环境请修改）
DB_PASSWORD=123456

# MySQL端口（可选，默认3306）
MYSQL_PORT=3306

# ==================== 应用配置 ====================
# 应用服务端口（可选，默认5001）
APP_PORT=5001

# Nginx服务端口（可选，默认80）
NGINX_PORT=80

# ==================== 安全配置 ====================
# JWT密钥（重要：生产环境请使用强密钥）
JWT_SECRET_KEY=your-jwt-secret-key-change-in-production-32chars

# JWT访问令牌过期时间（秒）
JWT_ACCESS_TOKEN_EXPIRES=3600

# Flask密钥（重要：生产环境请使用强密钥）
SECRET_KEY=your-flask-secret-key-change-in-production-32chars

# ==================== 文件上传配置 ====================
# 最大文件上传大小（MB）
MAX_CONTENT_LENGTH=100

# ==================== 调试配置 ====================
# 调试模式（生产环境请设置为False）
DEBUG=False
